<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ muestra su propio splash antes que Flutter: fondo pizarra y montaña cian -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/cresta_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/cresta_background</item>
    </style>
</resources>
